<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kelola Produk - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav', { storeName, active: 'admin-products' }) %>

  <main class="max-w-5xl mx-auto px-4 pb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-gray-700">Kelola Produk</h2>
      <a href="/admin/products/new" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 rounded-lg">
        + Tambah Produk
      </a>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-100 text-gray-600">
          <tr>
            <th class="px-4 py-2">Nama</th>
            <th class="px-4 py-2">Harga</th>
            <th class="px-4 py-2">Stok</th>
            <th class="px-4 py-2">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(product) { %>
            <tr class="border-t border-gray-100">
              <td class="px-4 py-2 font-medium text-gray-800"><%= product.name %></td>
              <td class="px-4 py-2 text-gray-600">Rp<%= product.price.toLocaleString('id-ID') %></td>
              <td class="px-4 py-2 text-gray-600"><%= product.stock %></td>
              <td class="px-4 py-2 space-x-2">
                <a href="/admin/products/<%= product.id %>/edit" class="text-blue-600 font-medium">Edit</a>
                <form method="POST" action="/admin/products/<%= product.id %>/delete" class="inline"
                  onsubmit="return confirm('Yakin hapus produk ini?')">
                  <button type="submit" class="text-red-600 font-medium">Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
