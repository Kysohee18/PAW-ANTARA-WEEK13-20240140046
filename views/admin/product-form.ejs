<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= product ? 'Edit' : 'Tambah' %> Produk - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav', { storeName, active: 'admin-products' }) %>

  <main class="max-w-lg mx-auto px-4 pb-10">
    <h2 class="font-semibold text-gray-700 mb-4"><%= product ? 'Edit' : 'Tambah' %> Produk</h2>

    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4"><%= error %></div>
    <% } %>

    <form
      method="POST"
      action="<%= product ? `/admin/products/${product.id}/edit` : '/admin/products/new' %>"
      class="bg-white border border-gray-200 rounded-xl p-6 space-y-3"
    >
      <input
        name="name" type="text" placeholder="Nama produk" required
        value="<%= product ? product.name : '' %>"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm"
      />
      <textarea
        name="description" placeholder="Deskripsi" rows="3"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm"
      ><%= product ? (product.description || '') : '' %></textarea>
      <div class="flex gap-3">
        <input
          name="price" type="number" placeholder="Harga" required min="0"
          value="<%= product ? product.price : '' %>"
          class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm"
        />
        <input
          name="stock" type="number" placeholder="Stok" required min="0"
          value="<%= product ? product.stock : '' %>"
          class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm"
        />
      </div>
      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg text-sm font-semibold">
        Simpan
      </button>
    </form>
  </main>
</body>
</html>
