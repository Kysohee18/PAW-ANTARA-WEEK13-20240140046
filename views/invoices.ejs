<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice - <%= storeName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('partials/nav', { storeName, active: 'invoice' }) %>

  <main class="max-w-3xl mx-auto px-4 pb-10">
    <h2 class="font-semibold text-gray-700 mb-4">Riwayat Invoice</h2>

    <% if (orders.length === 0) { %>
      <p class="text-center text-gray-400 py-10">Belum ada order masuk.</p>
    <% } %>

    <div class="space-y-3">
      <% orders.forEach(function(order) { %>
        <a href="/invoices/<%= order.id %>" class="block bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:border-blue-300">
          <div class="flex items-center justify-between mb-2">
            <span class="font-semibold text-gray-800">INV-<%= String(order.id).padStart(5, '0') %></span>
            <span class="text-xs text-gray-400">
              <%= new Date(order.createdAt).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %>
            </span>
          </div>
          <div class="text-sm text-gray-600 space-y-1">
            <p><strong><%= order.items.length %> produk</strong> — Total: Rp<%= order.totalAmount.toLocaleString('id-ID') %></p>
            <p><strong>Atas nama:</strong> <%= order.buyerName %></p>
            <p>
              <strong>Status:</strong>
              <%- include('partials/badge', { label: order.status, color: statusColor(order.status) }) %>
            </p>
          </div>
        </a>
      <% }) %>
    </div>
  </main>
</body>
</html>
